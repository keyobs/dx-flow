{
	"$schema": "https://biomejs.dev/schemas/VERSION/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
    "**",
    "!node_modules",
    "!!**/.angular",
    "!!**/dist",
    "!.vscode/launch.json",
    "!**/*.html"
    ]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"noUselessEmptyExport": "error"
			},
			"correctness": {
				"noUnusedImports": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		},
		 "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	}
}
